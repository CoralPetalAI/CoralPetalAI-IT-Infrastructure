# coralpetal.ai — Apache rules for Hostinger. Deployed with every environment.
# HTTPS is forced by Hostinger (hPanel → Security → SSL → Force HTTPS), not here,
# because the Hostinger CDN terminates TLS and a %{HTTPS} check here can loop.

Options -Indexes
ErrorDocument 404 /404.html
ErrorDocument 503 /back-soon.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # BEGIN BACK-SOON (prod only; Rohit 2026-11-18). Dev sites are unaffected (host check).
  # Go live = remove this block in a PR. Exempt: the page itself, version.json, robots, images, SSL checks.
  RewriteCond %{HTTP_HOST} ^(www\.)?coralpetal\.ai$ [NC]
  RewriteCond %{REQUEST_URI} !^/(back-soon\.html|version\.json|robots\.txt|img/|\.well-known/)
  RewriteRule ^ - [R=503,L]
  # END BACK-SOON

  # www → apex
  RewriteCond %{HTTP_HOST} ^www\.coralpetal\.ai$ [NC]
  RewriteRule ^ https://coralpetal.ai%{REQUEST_URI} [R=301,L]

  # Careers live on their own subdomain (2026-11-18, Rohit)
  RewriteCond %{HTTP_HOST} ^dev\. [NC]
  RewriteRule ^join-us/?$ https://dev-careers.coralpetal.ai/ [R=302,L]
  RewriteRule ^join-us/?$ https://careers.coralpetal.ai/ [R=301,L]

</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  <FilesMatch "\.(css|svg|png|jpg|webp|woff2)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  <FilesMatch "\.(html|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
