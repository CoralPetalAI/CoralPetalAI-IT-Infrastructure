# careers.coralpetal.ai — Apache rules for Hostinger. This folder sits inside the main
# docroot but is its own site: a sub-folder .htaccess does NOT inherit the parent's
# rewrite rules, so everything careers needs is here.
# HTTPS is forced by Hostinger (hPanel), not here (the CDN terminates TLS).

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
ErrorDocument 503 /back-soon.html

# BEGIN BACK-SOON (prod only; Rohit 2026-11-18). dev-careers is unaffected (host check).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^careers\.coralpetal\.ai$ [NC]
  RewriteCond %{REQUEST_URI} !^/(back-soon\.html|version\.json|robots\.txt|img/|\.well-known/)
  RewriteRule ^ - [R=503,L]
</IfModule>
# END BACK-SOON
